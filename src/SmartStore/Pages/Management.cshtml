@page
@model ManagementModel
@{
    ViewData["Title"] = "Store management";
    var revenue = Model.Sales.Where(s => s.PaymentStatus == "approved").Sum(s => s.Total);
}
<section class="hero"><div class="hero__copy"><span class="eyebrow">Management side · classroom demo</span>
    <h1>Store dashboard</h1><p>Review persistent inventory and recent sales. Receive deliveries or edit product details in Products.</p>
</div></section>
@if (Model.DatabaseWarning is not null) { <div class="notice notice--error" role="alert"><p>@Model.DatabaseWarning</p></div> }
<div class="workspace">
<section class="panel form-panel">
    <div class="panel__heading"><h2>Inventory</h2><a asp-page="/Products/Index">Manage products and deliveries →</a></div>
    @foreach (var product in Model.Products)
    {
        <div class="demo-cart-row"><span><strong>@product.Name</strong> · UPC @product.Code · EPC @product.Epc · $@product.Price.ToString("F2")</span><span>@product.Stock in stock</span></div>
    }
    @if (Model.Products.Count == 0) { <p>No inventory to display. Add products and receive stock from Products.</p> }
</section>
<aside class="sidebar"><section class="panel status-panel">
    <div class="panel__heading"><h2>Recent sales</h2></div>
        <p>Last @Model.Sales.Count sale(s) · @revenue.ToString("C") total shown</p>
        @foreach (var sale in Model.Sales)
        {
            <div class="demo-sale"><strong>@sale.CreatedAtUtc.ToLocalTime().ToString("g") · $@sale.Total.ToString("F2") · @sale.PaymentStatus</strong>
                <div>@string.Join(", ", sale.Items.Select(i => $"{i.Quantity}× {i.Name}"))</div>
                @if (sale.PaymentStatus == "approved") { <a asp-page="/Receipt" asp-route-id="@sale.Id">View receipt</a> }
            </div>
        }
        @if (Model.Sales.Count == 0) { <p>Make a demo purchase to see it here.</p> }
    <a asp-page="/Checkout">Go to self-checkout →</a>
</section></aside>
</div>
