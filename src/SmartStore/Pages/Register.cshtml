@page
@model RegisterModel
@{
    ViewData["Title"] = "Create account";
}

<section class="panel form-panel account-panel">
    @if (Model.Pending)
    {
        <h1>Verify your email</h1>
        <p>If registration can proceed, a code will arrive by email. It expires after 15 minutes. Already registered? Sign in or recover your account.</p>
        <form method="post" asp-page-handler="Verify" class="account-form">
            <div asp-validation-summary="ModelOnly" class="field-error" role="alert"></div>
            <label asp-for="Code">Verification code</label>
            <input asp-for="Code" autocomplete="one-time-code" spellcheck="false" maxlength="32" required />
            <span asp-validation-for="Code" class="field-error"></span>
            <button type="submit" class="primary-button">Verify and sign in</button>
        </form>
        <form method="post" asp-page-handler="Restart">
            <button type="submit" class="account-text-button">Start over</button>
        </form>
    }
    else
    {
        <h1>Create an account</h1>
        <p>Membership is optional at checkout. Your new account includes a membership number; previous email-only purchases are not automatically attached.</p>
        <form method="post" class="account-form">
            <div asp-validation-summary="ModelOnly" class="field-error" role="alert"></div>
            <label asp-for="FullName">Full name</label>
            <input asp-for="FullName" autocomplete="name" maxlength="100" required />
            <span asp-validation-for="FullName" class="field-error"></span>
            <label asp-for="Email"></label>
            <input asp-for="Email" type="email" autocomplete="username" maxlength="254" required />
            <span asp-validation-for="Email" class="field-error"></span>
            <label asp-for="Password"></label>
            <input asp-for="Password" type="password" autocomplete="new-password" minlength="12" maxlength="128" required aria-describedby="password-hint" />
            <span id="password-hint" class="account-hint">Use at least 12 characters.</span>
            <span asp-validation-for="Password" class="field-error"></span>
            <button type="submit" class="primary-button">Send verification code</button>
        </form>
        <p>Already have an account? <a asp-page="/Login">Sign in</a> · <a asp-page="/Recover">Recover account</a></p>
    }
</section>
