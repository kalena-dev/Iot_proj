@page
@model ErrorModel
@{
    ViewData["Title"] = "Something went wrong";
}

<section class="error-page">
    <span class="error-page__code">SYSTEM ERROR</span>
    <h1>We couldn't complete that request.</h1>
    <p>The application is still running. Return to customer registration and try again, or check the server log if the problem continues.</p>
    <a asp-page="/Index">Return to customer registration</a>
    @if (Model.ShowRequestId)
    {
        <small>Request ID: <code>@Model.RequestId</code></small>
    }
</section>
