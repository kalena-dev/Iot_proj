@using System.Globalization
@using SmartStore.Services
@model IReadOnlyList<DemoSale>
@{
    var currency = CultureInfo.GetCultureInfo("en-CA");
}
@if (Model.Count == 0)
{
    <p class="management-empty">No purchases in this view.</p>
}
else
{
    <div class="table-scroll" tabindex="0" role="region" aria-label="Purchase receipts">
        <table class="products-table">
            <thead><tr><th scope="col">Date and time</th><th scope="col">Items</th><th scope="col" class="num">Total</th><th scope="col">Receipt</th></tr></thead>
            <tbody>
            @foreach (var sale in Model)
            {
                <tr>
                    <td><time datetime="@sale.CreatedAtUtc.ToString("O")">@sale.CreatedAtUtc.ToLocalTime().ToString("g")</time></td>
                    <td>@string.Join(", ", sale.Items.Select(item => $"{item.Quantity}× {item.Name}"))</td>
                    <td class="num">@sale.Total.ToString("C", currency)</td>
                    <td><a asp-page="/Receipt" asp-route-id="@sale.Id">View receipt</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
