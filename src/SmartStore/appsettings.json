{
  "MongoDb": {
    "DatabaseName": "smart_store",
    "CustomersCollectionName": "customers",
    "ProductsCollectionName": "products",
    "ReceptionsCollectionName": "receptions",
    "ServerSelectionTimeoutSeconds": 8
  },
  "Gpio": {
    "Enabled": true,
    "BlueLedPin": 5,
    "RedLedPin": 6,
    "BuzzerPin": 22,
    "BuzzerEnabled": true,
    "SuccessDurationMilliseconds": 1500,
    "FailureBeepCount": 3,
    "FailureBeepMilliseconds": 450,
    "BuzzerMode": "Passive",
    "BuzzerFrequencyHz": 2000
  },
  "Iot": {
    "BaseUrl": "http://127.0.0.1:3100/"
  },
  "Security": {
    "UseHttpsRedirection": true,
    "TrustedProxies": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "MongoDB.Driver": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Rfid": {
    "Mode": "Simulation"
  }
}
