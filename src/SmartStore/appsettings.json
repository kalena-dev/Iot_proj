{
  "MongoDb": {
    "DatabaseName": "smart_store",
    "CustomersCollectionName": "customers",
    "ServerSelectionTimeoutSeconds": 8
  },
  "Gpio": {
    "Enabled": true,
    "BlueLedPin": 17,
    "RedLedPin": 27,
    "BuzzerPin": 22,
    "SuccessDurationMilliseconds": 1500,
    "FailureBeepCount": 3,
    "FailureBeepMilliseconds": 180
  },
  "Security": {
    "UseHttpsRedirection": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "MongoDB.Driver": "Warning"
    }
  },
  "AllowedHosts": "*"
}
