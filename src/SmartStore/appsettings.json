{
  "MongoDb": {
    "DatabaseName": "smart_store",
    "CustomersCollectionName": "customers",
    "ServerSelectionTimeoutSeconds": 8
  },
  "Gpio": {
    "Enabled": true,
    "BlueLedPin": 17,
    "RedLedPin": 27,
    "BuzzerPin": 22,
    "BuzzerEnabled": true,
    "SuccessDurationMilliseconds": 1500,
    "FailureBeepCount": 3,
    "FailureBeepMilliseconds": 450,
    "BuzzerMode": "Passive",
    "BuzzerFrequencyHz": 2000
  },
  "Iot": {
    "BaseUrl": "http://127.0.0.1:3100/"
  },
  "Security": {
    "UseHttpsRedirection": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "MongoDB.Driver": "Warning"
    }
  },
  "AllowedHosts": "*"
}
