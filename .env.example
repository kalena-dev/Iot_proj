# Copy to .env at the repository root. Never commit real credentials.
# Existing Phase 1 customer/sales database and Phase 2 telemetry/settings.
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net"
MONGODB_DATABASE="smart_store"

# Mosquitto on this server; ESP32 firmware discovers it automatically.
# MQTT_URL is authoritative for the TypeScript service AND Python fan worker.
# Use mqtts:// with a TLS broker; do not enable TLS against a plain listener.
MQTT_URL="mqtt://127.0.0.1:1883"
# Legacy host/port/TLS fallback for the fan worker when MQTT_URL is unset:
MQTT_HOST="127.0.0.1"
MQTT_PORT=1883
MQTT_USER="northstar"
MQTT_PASSWORD="REPLACE_WITH_MOSQUITTO_PASSWORD"
MQTT_TLS=false
# Advertise this computer's local broker to ESP32s using mDNS (UDP5353).
# No server IP is embedded in sensor firmware; LAN client traffic must be allowed.
MQTT_DISCOVERY_ENABLED=true

# TypeScript API is loopback-only. C# reads this same optional shared key.
IOT_PORT=3100
IOT_API_KEY="REPLACE_WITH_A_RANDOM_LOCAL_API_KEY"
DEFAULT_THRESHOLD=8
SENSOR_STALE_SECONDS=30
ALERT_COOLDOWN_SECONDS=900
REPLY_EXPIRY_SECONDS=900
EMAIL_RETRY_SECONDS=60

# Guided Gmail setup: npm --prefix iot-server run setup:email (docs/EMAIL_SETUP.md).
# It validates SMTP/IMAP before saving/enabling; no ESP32 reflash is required.
# For manual setup, fill every SMTP/IMAP setting. Use a dedicated mailbox and
# provider app passwords, NOT your normal account password. SMTP uses TLS;
# IMAP uses SSL. The recipient must reply from ALERT_TO and retain the subject.
EMAIL_ENABLED=false
ALERT_TO="owner@example.com"
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="iot-alerts@example.com"
SMTP_PASSWORD="REPLACE_WITH_APP_PASSWORD"
SMTP_FROM="iot-alerts@example.com"
IMAP_HOST="imap.example.com"
IMAP_PORT=993
IMAP_USER="iot-alerts@example.com"
IMAP_PASSWORD="REPLACE_WITH_APP_PASSWORD"

# L293D: GPIO27 -> EN1, GPIO17 -> IN2, IN1 -> GND.
# +Vmotor uses a suitable motor supply, NEVER a GPIO; all grounds must be common.
FAN_GPIO=27
FAN_IN2_GPIO=17
# These pins replace the old GPIO17/27 LEDs. Do not run both GPIO owners.
GPIO__ENABLED=false
# Set true only after physically checking the driver wiring and power supply.
FAN_WIRING_CONFIRMED=false
# Simulation is explicit and displayed on the dashboard. Set false for the lab.
FAN_SIMULATE=false
FAN_MAX_RUN_SECONDS=300
