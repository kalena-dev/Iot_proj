# Copy to .env at the repository root. Never commit real credentials.
# Existing Phase 1 customer/sales database and Phase 2 telemetry/settings.
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net"
MONGODB_DATABASE="smart_store"

# Mosquitto on the Raspberry Pi; ESP32 secrets.h uses the Pi's LAN IP.
MQTT_URL="mqtt://127.0.0.1:1883"
MQTT_HOST="127.0.0.1"
MQTT_PORT=1883
MQTT_USER="northstar"
MQTT_PASSWORD="REPLACE_WITH_MOSQUITTO_PASSWORD"
MQTT_TLS=false

# TypeScript API is loopback-only. C# reads this same optional shared key.
IOT_PORT=3100
IOT_API_KEY="REPLACE_WITH_A_RANDOM_LOCAL_API_KEY"
DEFAULT_THRESHOLD=8
SENSOR_STALE_SECONDS=30
ALERT_COOLDOWN_SECONDS=900
REPLY_EXPIRY_SECONDS=900
EMAIL_RETRY_SECONDS=60

# Enable after filling every SMTP/IMAP setting. Use a dedicated mailbox and
# provider app passwords, NOT your normal account password. SMTP uses TLS;
# IMAP uses SSL. The recipient must reply from ALERT_TO and retain the subject.
EMAIL_ENABLED=false
ALERT_TO="owner@example.com"
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="iot-alerts@example.com"
SMTP_PASSWORD="REPLACE_WITH_APP_PASSWORD"
SMTP_FROM="iot-alerts@example.com"
IMAP_HOST="imap.example.com"
IMAP_PORT=993
IMAP_USER="iot-alerts@example.com"
IMAP_PASSWORD="REPLACE_WITH_APP_PASSWORD"

# Motor driver ENA uses BCM23, separate from existing LEDs/buzzer.
# Simulation is explicit and displayed on the dashboard. Set false for the lab.
FAN_GPIO=23
FAN_SIMULATE=false
FAN_MAX_RUN_SECONDS=300
