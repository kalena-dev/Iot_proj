# Local development template. Never commit a real .env, passwords, keys, or certificates.
# Deployed services use separate /etc/northstar/web.env, iot.env, and fan.env files.
# The fan environment must contain only MQTT, GPIO and wiring settings.
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net"
MONGODB_DATABASE="smart_store"

# Provision immutable account IDs, not email addresses. Staff must freshly authenticate.
# Copy your own account ID from My account after verified registration.
AUTH_ADMIN_ACCOUNT_IDS=""

# Verified TLS for every MQTT client. Provision certificates/identities with pi/provision-mqtt.sh.
# Use the broker's certificate DNS name, never disable certificate validation.
MQTT_URL="mqtts://localhost:8883"
MQTT_CA_FILE="/etc/northstar/certs/ca.crt"
MQTT_SERVER_NAME="northstar-broker.local"
# The IoT service, fan and each sensor need different users/passwords with topic ACLs.
# Use northstar-iot here; fan.env uses northstar-fan and has no database/mail credentials.
MQTT_USER="northstar-iot"
MQTT_PASSWORD="REPLACE_WITH_IOT_ROLE_PASSWORD"
MQTT_DISCOVERY_ENABLED=true

# The local control API is loopback-only and refuses missing/example keys.
# Generate privately: openssl rand -hex 32
IOT_PORT=3100
IOT_API_KEY="REPLACE_WITH_A_RANDOM_64_HEX_KEY"
DEFAULT_THRESHOLD=8
SENSOR_STALE_SECONDS=30
ALERT_COOLDOWN_SECONDS=900
REPLY_EXPIRY_SECONDS=900
EMAIL_RETRY_SECONDS=60

# Shared SMTP transport: 587 + STARTTLS works for web registration/receipts AND alerts.
# Dedicated application mailbox; use provider app passwords, not your main password.
EMAIL_ENABLED=false
ALERT_TO="owner@example.com"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="iot-alerts@example.com"
SMTP_PASSWORD="REPLACE_WITH_APP_PASSWORD"
SMTP_FROM="iot-alerts@example.com"
IMAP_HOST="imap.gmail.com"
IMAP_PORT=993
IMAP_USER="iot-alerts@example.com"
IMAP_PASSWORD="REPLACE_WITH_APP_PASSWORD"

# Integrated wiring: move the two Phase 1 LEDs before enabling these settings.
# Blue BCM5 (physical29), red BCM6 (physical31), buzzer BCM22 (physical15).
# Fan L293D EN1=BCM27, IN2=BCM17, IN1=GND. Never share GPIO owners.
GPIO__ENABLED=true
GPIO__BLUELEDPIN=5
GPIO__REDLEDPIN=6
GPIO__BUZZERPIN=22
FAN_GPIO=27
FAN_IN2_GPIO=17
# Set true only after checking physical inputs, common ground, supply and power cutoff.
FAN_WIRING_CONFIRMED=false
FAN_SIMULATE=false
FAN_MAX_RUN_SECONDS=300

# HTTPS web listener/certificate configuration is required; see README deployment steps.
# ASPNETCORE_URLS=https://localhost:7051
# ASPNETCORE_Kestrel__Certificates__Default__Path=/private/path/web.pfx
# ASPNETCORE_Kestrel__Certificates__Default__Password=

# Minew MSP01 via Pareto Anywhere. Plain HTTP is permitted only on loopback.
# Remote middleware requires certificate-validated HTTPS.
# MSP01_PARETO_URL=http://127.0.0.1:3001/
# MSP01_DEVICE_ID=
# MSP01_DEVICE_TYPE=2
