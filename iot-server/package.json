{
  "name": "northstar-phase2-iot",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "setup:email": "tsx src/setup-email.ts",
    "check:email": "tsx src/setup-email.ts --check",
    "test": "tsx --test test/*.test.ts",
    "test:integration": "tsx --test test/integration/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.10.1",
    "bonjour-service": "^1.4.4",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "imapflow": "^1.0.191",
    "mailparser": "^3.7.4",
    "mongodb": "^6.20.0",
    "mqtt": "^5.14.1",
    "nodemailer": "^10.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^7.0.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
