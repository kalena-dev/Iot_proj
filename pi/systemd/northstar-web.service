[Unit]
Description=Northstar existing Razor Pages store and refrigeration dashboard
After=network-online.target northstar-iot.service
Wants=network-online.target

[Service]
Type=simple
# Render these placeholders with pi/install-services.sh.
User=@USER@
WorkingDirectory=@PROJECT_ROOT@/publish/web
Environment=ASPNETCORE_URLS=http://0.0.0.0:5198
ExecStart="@DOTNET@" "@PROJECT_ROOT@/publish/web/SmartStore.dll"
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
