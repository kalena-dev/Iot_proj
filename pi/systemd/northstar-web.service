[Unit]
Description=Northstar existing Razor Pages store and refrigeration dashboard
After=network-online.target northstar-iot.service
Wants=network-online.target

[Service]
Type=simple
# Render these placeholders with pi/install-services.sh.
User=northstar-web
Group=northstar-web
SupplementaryGroups=gpio
WorkingDirectory="@PROJECT_ROOT@/web"
EnvironmentFile=/etc/northstar/web.env
Environment=NORTHSTAR_CONFIG_FILE=/etc/northstar/web.env
Environment=ASPNETCORE_URLS=http://127.0.0.1:5198
Environment=HOME=/var/lib/northstar-web
ExecStart="@DOTNET@" "@PROJECT_ROOT@/web/SmartStore.dll"
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
UMask=0077
StateDirectory=northstar-web
StateDirectoryMode=0700
ReadWritePaths=/var/lib/northstar-web
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
InaccessiblePaths=-/etc/northstar/iot.env -/etc/northstar/fan.env

[Install]
WantedBy=multi-user.target
