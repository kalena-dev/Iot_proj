[Unit]
Description=Northstar Phase 2 TypeScript MQTT and email service
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
# Render these placeholders with pi/install-services.sh.
User=@USER@
WorkingDirectory=@PROJECT_ROOT@
ExecStart="@NODE@" "@PROJECT_ROOT@/iot-server/dist/main.js"
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
