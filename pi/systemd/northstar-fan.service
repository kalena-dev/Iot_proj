[Unit]
Description=Northstar Raspberry Pi fan actuator
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
# Render these placeholders with pi/install-services.sh.
User=@USER@
SupplementaryGroups=gpio
WorkingDirectory=@PROJECT_ROOT@
ExecStart="@PYTHON@" "@PROJECT_ROOT@/pi/fan_controller.py"
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
