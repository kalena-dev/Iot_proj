# Explicit initial install: pi/install-mqtt.sh. Audit other includes for listeners.
# No plaintext listener. Revoke old shared credentials when migrating.
per_listener_settings true
listener 8883
protocol mqtt
allow_anonymous false
password_file /etc/mosquitto/northstar/passwords
acl_file /etc/mosquitto/northstar/acl
cafile /etc/mosquitto/northstar/ca.crt
certfile /etc/mosquitto/northstar/server.crt
keyfile /etc/mosquitto/northstar/server.key
tls_version tlsv1.2
require_certificate false
# Server-authenticated TLS plus separate password identities/deny-default ACL.
# Debian/Raspberry Pi OS's main mosquitto.conf already configures persistence.
